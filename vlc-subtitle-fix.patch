+++ b/application/vlc-android/src/org/videolan/vlc/gui/video/VideoPlayerOverlayDelegate.kt
@@ -1105,7 +1105,23 @@ class VideoPlayerOverlayDelegate (private val player: VideoPlayerActivity) {
 
     private fun pickSubtitles() {
         val uri = player.videoUri ?: return
-        val media = if (uri.scheme.isSchemeFile() || uri.scheme.isSchemeNetwork()) MediaWrapperImpl(FileUtils.getParent(uri.toString())!!.toUri()) else null
+        // Resolve the video location so the subtitle picker opens in the SAME folder.
+        // For file:// / network we use the parent dir directly. For content:// (e.g. the
+        // video was opened via "Open with" / a file manager) we resolve the real file path
+        // first, otherwise the picker falls back to the root and cannot list the .srt that
+        // lives next to the video on real storage.
+        val media = when {
+            uri.scheme.isSchemeFile() || uri.scheme.isSchemeNetwork() ->
+                MediaWrapperImpl(FileUtils.getParent(uri.toString())!!.toUri())
+            uri.scheme == "content" -> {
+                val realPath = FileUtils.getPathFromURI(uri)
+                if (realPath.isNotEmpty()) {
+                    val parent = FileUtils.getParent(realPath)
+                    if (parent != null) MediaWrapperImpl(parent.toUri()) else null
+                } else null
+            }
+            else -> null
+        }
         player.isShowingDialog = true
         val filePickerIntent = Intent(player, FilePickerActivity::class.java)
         filePickerIntent.putExtra(KEY_MEDIA, media)
